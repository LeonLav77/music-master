# Leave VITE_API_URL unset: the UI derives the API host from whatever address
# the page was opened at, so http://<pc-ip>:8080 on a phone reaches the API at
# http://<pc-ip>:8000 automatically. Hardcoding localhost here breaks every
# device except the one running the server.
#
# Only set it when the API is somewhere else than the machine serving the UI:
# VITE_API_URL=http://192.168.1.124:8000
