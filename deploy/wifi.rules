// Let the server - user leon, running from systemd - change Wi-Fi.
//
// NetworkManager asks polkit before every change. Without a desktop
// session behind it, the server's nmcli calls are refused: saving and
// forgetting networks, and turning the hotspot on and off (server/wifi.py).
polkit.addRule(function (action, subject) {
  if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0 && subject.user === "leon") {
    return polkit.Result.YES;
  }
});
