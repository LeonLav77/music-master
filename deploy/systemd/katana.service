[Unit]
Description=Katana control surface (API, aux deck and UI)
Documentation=https://github.com/LeonLav77/boss_test

# Wants, not Requires: the network is where clients come from, not something
# the amp needs. The USB cable to the amp works with no network at all, and
# the server must come up regardless so the AP has something to serve.
Wants=network.target
After=network.target

# Do not give up. The default (5 starts in 10s) would leave the server dead
# for good after a transient failure, which is the one outcome that cannot
# be recovered from without a laptop.
StartLimitIntervalSec=0

[Service]
Type=exec
User=katana
Group=katana
# audio for ALSA (the MIDI port lives there), plugdev for the raw USB device.
SupplementaryGroups=audio plugdev

WorkingDirectory=/opt/katana

# PipeWire is a *user* service, reached over a socket in the user's runtime
# directory. A system service gets no XDG_RUNTIME_DIR of its own, so without
# this the aux deck finds no sound card at all - the sink list comes back
# empty even though the hardware is fine and pw-play works by hand.
#
# `loginctl enable-linger katana` is what makes that directory exist without
# anyone logging in; install.sh does it.
# __UID__ is replaced by install.sh with the katana user's real uid.
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=PULSE_RUNTIME_PATH=/run/user/__UID__/pulse
ExecStart=/opt/katana/venv/bin/python -m server.app --host 0.0.0.0 --port 8000

# The amp being absent is normal - it powers up with the rig, and the server
# reconnects on its own. Restart is for the server dying, which on a Pi in a
# gig bag has to be self-healing: nobody is going to ssh in mid-set.
Restart=always
RestartSec=2

# Log to the journal; there is no screen to print to.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=katana

# Modest hardening. Not a security boundary - it runs on a private AP - but
# it costs nothing and keeps a bug from writing outside its own tree.
NoNewPrivileges=yes
ProtectSystem=full

# ProtectHome=yes would be the obvious thing here, but it makes /run/user
# inaccessible - and that is where PipeWire's socket lives. With it on, the
# aux deck finds no sound card at all: the sink list comes back empty while
# the very same command works by hand. read-only keeps /home protected
# without hiding the socket.
ProtectHome=read-only

# PrivateTmp gives the service its own /tmp, which breaks the PipeWire
# client's shared-memory handshake.
PrivateTmp=no
# tracks/ and patches/ live under the working directory and must stay writable.
ReadWritePaths=/opt/katana

[Install]
WantedBy=multi-user.target
