node_modules/
.pnp
.pnp.js

# Build output
.output/
.nitro/
.vinxi/
.tanstack/
dist/
build/

# Vite / bundler caches
.vite/
*.tsbuildinfo

# Cloudflare / Wrangler
.wrangler/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# ---------------------------------------------------------------
# Secrets & local config
# ---------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# ---------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------
# Vendored upstream sources
# Cloned reference repos that carry their own .git directory.
# Tracking these would create a broken gitlink, so they stay out.
#   vendor/katana-midi-bridge -> https://github.com/snhirsch/katana-midi-bridge.git
#
# Anchored: web/vendor/ holds Alpine, which IS tracked - the surface must
# work offline, so an unanchored "vendor/" silently dropped it.
# ---------------------------------------------------------------
/vendor/

# ---------------------------------------------------------------
# Editors & OS cruft
# ---------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini

# Archives - GitHub rejects blobs over 100 MB, and they do not belong in git.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
